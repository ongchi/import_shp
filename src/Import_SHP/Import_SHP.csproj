<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TargetExt>.rhp</TargetExt>
    <!-- The plugin needs no companion files: the only reference is RhinoCommon, which the Rhino
         process already holds. A single .rhp file installs by a copy or by a drag into Rhino. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <AssemblyName>Import_SHP</AssemblyName>
    <RootNamespace>Import_SHP</RootNamespace>
    <Version>1.0.0</Version>
    <Title>Shapefile Import</Title>
    <Description>Imports ESRI shapefiles into Rhino.</Description>
    <Company>-</Company>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.34.26223.11001" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
